{%- comment -%}
  Erhvervsportal på /pages/erhverv. Skærmen vælges ud fra kundens tags:
    ikke logget ind        → log ind eller ansøg
    erhverv-afventer       → afventer godkendelse
    erhverv-afvist         → kort besked
    erhverv-godkendt       → Min aftale, Vælg varer, Ordrer og fakturaer
  Rabatsatserne læses fra butikkens metafelt erhverv.niveauer, som appens
  side «Prisniveauer» skriver. Selve rabatten gives af rabatfunktionen i
  checkout — tallene her er kun til visning.
{%- endcomment -%}
{%- liquid
  assign skaerm = 'gaest'
  if customer
    assign skaerm = 'ingen'
    if customer.tags contains 'erhverv-godkendt'
      assign skaerm = 'godkendt'
    elsif customer.tags contains 'erhverv-afventer'
      assign skaerm = 'afventer'
    elsif customer.tags contains 'erhverv-afvist'
      assign skaerm = 'afvist'
    endif
  endif

  assign niveau = 0
  for n in (1..3)
    assign t = 'erhverv-niveau-' | append: n
    if customer.tags contains t
      assign niveau = n
    endif
  endfor

  assign satser = shop.metafields.erhverv.niveauer.value
  assign sats = 0
  if niveau > 0
    assign key = niveau | append: ''
    assign sats = satser[key] | default: 0
    if sats == 0
      case niveau
        when 1
          assign sats = 10
        when 2
          assign sats = 15
        when 3
          assign sats = 20
      endcase
    endif
  endif
  assign faktor = 100 | minus: sats

  assign em = customer.metafields.erhverv
  assign firmanavn = em.firmanavn.value | default: customer.default_address.company | default: customer.name
  assign ansoeg_url = block.settings.apply_url | default: '/pages/kaffe-til-erhverv'
-%}
<div class="costa erhverv erhverv-portal" data-skaerm="{{ skaerm }}" {{ block.shopify_attributes }}>
  <div class="costa__inner">
    {%- case skaerm -%}
      {%- when 'gaest' or 'ingen' -%}
        <div class="erhverv-portal__intro">
          <p class="costa-label">Erhvervsportal</p>
          <h1 class="erhverv__title">{{ block.settings.guest_heading | escape }}</h1>
          <div class="costa-richtext">{{ block.settings.guest_text }}</div>
        </div>
        <div class="erhverv-portal__choices">
          {%- if skaerm == 'gaest' -%}
            <div class="costa-card erhverv-card">
              <p class="costa-label">Erhvervskunde</p>
              <h2 class="erhverv__subtitle">Log ind</h2>
              <p>Log ind med den e-mail, I ansøgte med, for at se jeres aftale og bestille til erhvervspris.</p>
              {%- comment -%}
                storefront_login_url sender kunden tilbage til portalen efter
                login. account_login_url ender på kontosiden.
              {%- endcomment -%}
              <a class="costa-button costa-button--primary" href="{{ routes.storefront_login_url }}">Log ind</a>
            </div>
          {%- else -%}
            <div class="costa-card erhverv-card">
              <p class="costa-label">Logget ind som</p>
              <h2 class="erhverv__subtitle">{{ customer.email | escape }}</h2>
              <p>Kontoen har ingen erhvervsaftale endnu. Er I logget ind med en anden e-mail end den, I ansøgte med?</p>
              <a class="costa-button" href="{{ routes.account_logout_url }}">Log ud</a>
            </div>
          {%- endif -%}
          <div class="costa-card erhverv-card erhverv-card--kraft">
            <p class="costa-label">Ny virksomhed</p>
            <h2 class="erhverv__subtitle">Ansøg om en aftale</h2>
            <p>Friskristet kaffe til kontoret, kantinen eller butikken — med fast erhvervspris og levering fra Kalundborg.</p>
            <a class="costa-button" href="{{ ansoeg_url }}">Ansøg</a>
          </div>
        </div>

      {%- when 'afventer' -%}
        <div class="erhverv-portal__status">
          <p class="costa-label">{{ firmanavn | escape }}</p>
          <h1 class="erhverv__title">Afventer godkendelse</h1>
          <div class="costa-richtext">{{ block.settings.pending_text }}</div>
          <ol class="erhverv-steps" role="list">
            <li class="is-done"><span>1</span>Ansøgning sendt</li>
            <li class="is-current"><span>2</span>Vi ser på den</li>
            <li><span>3</span>I kan bestille</li>
          </ol>
          <a class="costa-button" href="{{ routes.collections_url }}/all">Se kaffen imens</a>
        </div>

      {%- when 'afvist' -%}
        <div class="erhverv-portal__status">
          <p class="costa-label">{{ firmanavn | escape }}</p>
          <h1 class="erhverv__title">Ingen erhvervsaftale</h1>
          <div class="costa-richtext">{{ block.settings.rejected_text }}</div>
          <a class="costa-button" href="{{ routes.collections_url }}/all">Gå til webshoppen</a>
        </div>

      {%- when 'godkendt' -%}
        <header class="erhverv-portal__head">
          <div>
            <p class="costa-label">Erhvervsportal</p>
            <h1 class="erhverv__title">{{ firmanavn | escape }}</h1>
          </div>
          {%- if niveau > 0 -%}
            <p class="erhverv-level"><span class="costa-label">Prisniveau {{ niveau }}</span><strong>{{ sats }} %</strong><span class="costa-muted">rabat på kaffen</span></p>
          {%- endif -%}
        </header>

        <div class="erhverv-tabs" role="tablist" aria-label="Erhvervsportal" data-erhverv-tabs>
          <button type="button" role="tab" id="Tab-aftale-{{ block.id }}" aria-controls="Panel-aftale-{{ block.id }}" aria-selected="true" data-tab="aftale">Min aftale</button>
          <button type="button" role="tab" id="Tab-varer-{{ block.id }}" aria-controls="Panel-varer-{{ block.id }}" aria-selected="false" tabindex="-1" data-tab="varer">Vælg varer</button>
          <button type="button" role="tab" id="Tab-ordrer-{{ block.id }}" aria-controls="Panel-ordrer-{{ block.id }}" aria-selected="false" tabindex="-1" data-tab="ordrer">Ordrer og fakturaer</button>
        </div>

        {%- comment -%} Min aftale {%- endcomment -%}
        <section class="erhverv-panel" role="tabpanel" id="Panel-aftale-{{ block.id }}" aria-labelledby="Tab-aftale-{{ block.id }}" data-panel="aftale">
          <div class="erhverv-grid">
            <div class="costa-card erhverv-card">
              <p class="costa-label">Firmaoplysninger</p>
              <dl class="erhverv-dl">
                <dt>Firma</dt><dd>{{ firmanavn | escape }}</dd>
                {%- if em.cvr.value != blank -%}<dt>CVR</dt><dd>{{ em.cvr.value | escape }}</dd>{%- endif -%}
                {%- if customer.default_address -%}
                  <dt>Levering</dt><dd>{{ customer.default_address.address1 | escape }}<br>{{ customer.default_address.zip | escape }} {{ customer.default_address.city | escape }}</dd>
                {%- endif -%}
                <dt>Kontakt</dt><dd>{{ em.kontaktperson.value | default: customer.name | escape }}<br>{{ customer.email | escape }}{% if customer.phone != blank %}<br>{{ customer.phone | escape }}{% endif %}</dd>
              </dl>
            </div>
            <div class="costa-card erhverv-card">
              <p class="costa-label">Prisniveau</p>
              <p class="erhverv-big">{{ sats }} %</p>
              <p>Niveau {{ niveau }}. Rabatten trækkes automatisk fra i kurven, når I er logget ind.</p>
            </div>
            <div class="costa-card erhverv-card">
              <p class="costa-label">Jeres kontakt hos os</p>
              <p class="erhverv-contact-name">{{ block.settings.contact_name | escape }}</p>
              {%- if block.settings.contact_phone != blank -%}<p><a href="tel:{{ block.settings.contact_phone | remove: ' ' }}">{{ block.settings.contact_phone | escape }}</a></p>{%- endif -%}
              {%- if block.settings.contact_email != blank -%}<p><a href="mailto:{{ block.settings.contact_email }}">{{ block.settings.contact_email | escape }}</a></p>{%- endif -%}
            </div>
            <div class="costa-card erhverv-card erhverv-card--soon">
              <p class="costa-label">Fast levering</p>
              <p class="erhverv-soon">Kommer snart</p>
              <p class="costa-muted">Få kaffen leveret fast hver uge eller måned.</p>
            </div>
          </div>
        </section>

        {%- comment -%} Vælg varer {%- endcomment -%}
        <section class="erhverv-panel" role="tabpanel" id="Panel-varer-{{ block.id }}" aria-labelledby="Tab-varer-{{ block.id }}" data-panel="varer" hidden>
          {%- assign kol = block.settings.collection -%}
          {%- if kol == blank or kol.products_count == 0 -%}
            <p class="costa-form__status">Vælg erhvervskollektionen i temaredigeringen under blokken «Erhvervsportal».</p>
          {%- else -%}
            <p class="costa-muted erhverv-note">Priserne er vist med jeres rabat på {{ sats }} %. Fragt lægges til i kassen. Bestillingen går gennem den almindelige kasse.</p>
            {%- comment -%}
              Samme kaffeposer som i webshoppen: temaets costa-bag-klasser.
              Prisen er erhvervsprisen; listeprisen står streget over.
            {%- endcomment -%}
            <ul class="costa-shop__grid erhverv-shop" role="list" style="--costa-shop-columns: 3;">
              {%- for product in kol.products limit: 24 -%}
                {%- liquid
                  assign v0 = product.selected_or_first_available_variant
                  assign pris0 = v0.price | times: faktor | divided_by: 100
                  assign ristning = product.metafields.custom.ristning.value
                  assign r = ristning | downcase
                  assign tone = 'medium'
                  assign level = 3
                  if r contains 'lys' or r contains 'light'
                    assign tone = 'light'
                    assign level = 1
                  elsif r contains 'mørk' or r contains 'dark'
                    assign tone = 'dark'
                    assign level = 5
                  elsif r == blank
                    assign level = 0
                  endif
                -%}
                <li class="costa-shop__item">
                  <article class="costa-bag">
                    <div class="costa-bag__seal" aria-hidden="true"></div>
                    {%- if product.featured_media -%}
                      <a class="costa-bag__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                        {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 100vw', alt: product.featured_media.alt | default: product.title | escape }}
                      </a>
                    {%- else -%}
                      <a class="costa-bag__media costa-bag__media--empty costa-roast--{{ tone }}" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                        <span class="costa-bag__front">
                          <span class="costa-bag__brand">Café Costa</span>
                          <span class="costa-bag__sub">Erhverv</span>
                          {%- if level > 0 -%}
                            <span class="costa-roast-meter">
                              {%- for i in (1..5) -%}<span class="costa-roast-meter__dot{% if i <= level %} is-on{% endif %}"></span>{%- endfor -%}
                            </span>
                          {%- endif -%}
                        </span>
                      </a>
                    {%- endif -%}

                    <div class="costa-bag__label">
                      <div class="costa-bag__top">
                        <span>{% if ristning != blank %}Ristning · {{ ristning | escape }}{% else %}{{ product.type | escape }}{% endif %}</span>
                        {%- if sats > 0 -%}<span>Erhvervspris</span>{%- endif -%}
                      </div>
                      <h3 class="costa-bag__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                      {%- if product.metafields.custom.smagsnoter.value != blank -%}<p class="costa-bag__notes">{{ product.metafields.custom.smagsnoter.value | escape }}</p>{%- endif -%}
                    </div>

                    {%- form 'product', product, class: 'costa-bag__form', novalidate: 'novalidate' -%}
                      {%- if product.has_only_default_variant -%}
                        <input type="hidden" name="id" value="{{ v0.id }}">
                      {%- else -%}
                        <fieldset class="costa-pills">
                          <legend class="visually-hidden">Kassestørrelse</legend>
                          {%- for variant in product.variants -%}
                            {%- assign pris = variant.price | times: faktor | divided_by: 100 -%}
                            <label class="costa-pill">
                              <input type="radio" name="id" value="{{ variant.id }}" data-erhverv-variant data-pris="{{ pris | money }}" data-liste="{{ variant.price | money }}" {% if variant == v0 %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
                              <span>{{ variant.title | escape }}</span>
                            </label>
                          {%- endfor -%}
                        </fieldset>
                      {%- endif -%}
                      <input type="hidden" name="quantity" value="1">
                      <div class="costa-bag__buy">
                        <span class="costa-price">
                          {%- if sats > 0 -%}<s data-erhverv-liste>{{ v0.price | money }}</s> {% endif -%}
                          <span data-erhverv-pris>{{ pris0 | money }}</span>
                        </span>
                        <button type="submit" class="costa-button costa-button--buy costa-button--small" {% unless product.available %}disabled{% endunless %}>
                          {%- if product.available -%}Læg i kurv{%- else -%}Udsolgt{%- endif -%}
                        </button>
                      </div>
                    {%- endform -%}
                  </article>
                </li>
              {%- endfor -%}
            </ul>
            <a class="costa-button" href="{{ routes.cart_url }}">Gå til kurven</a>
          {%- endif -%}
        </section>

        {%- comment -%} Ordrer og fakturaer {%- endcomment -%}
        <section class="erhverv-panel" role="tabpanel" id="Panel-ordrer-{{ block.id }}" aria-labelledby="Tab-ordrer-{{ block.id }}" data-panel="ordrer" hidden>
          {%- if customer.orders.size == 0 -%}
            <p class="costa-form__status">Ingen ordrer endnu. Bestil under «Vælg varer».</p>
          {%- else -%}
            <div class="erhverv-table" role="table" aria-label="Ordrer">
              <div class="erhverv-table__row erhverv-table__head" role="row">
                <span role="columnheader">Ordre</span><span role="columnheader">Dato</span><span role="columnheader">Betaling</span><span role="columnheader">Levering</span><span role="columnheader">Beløb</span><span role="columnheader"><span class="visually-hidden">Faktura</span></span>
              </div>
              {%- for order in customer.orders limit: 25 -%}
                <div class="erhverv-table__row" role="row">
                  <span role="cell"><strong>{{ order.name }}</strong></span>
                  {%- comment -%} Dansk månedsnavn: date-filteret giver engelsk. {%- endcomment -%}
                  {%- assign md = order.created_at | date: '%m' | plus: 0 | minus: 1 -%}
                  {%- assign maaneder = 'jan.,feb.,mar.,apr.,maj,jun.,jul.,aug.,sep.,okt.,nov.,dec.' | split: ',' -%}
                  <span role="cell">{{ order.created_at | date: '%-d.' }} {{ maaneder[md] }} {{ order.created_at | date: '%Y' }}</span>
                  <span role="cell"><span class="erhverv-pill">{{ order.financial_status_label }}</span></span>
                  <span role="cell"><span class="erhverv-pill">{{ order.fulfillment_status_label }}</span></span>
                  <span role="cell">{{ order.total_price | money }}</span>
                  <span role="cell"><a href="{{ order.order_status_url }}">Faktura</a></span>
                </div>
              {%- endfor -%}
            </div>
            <p class="costa-muted erhverv-note">Fakturaen er ordrens kvittering med firmanavn og moms. Har I brug for en faktura med EAN, så skriv til os.</p>
          {%- endif -%}
        </section>
    {%- endcase -%}
  </div>
</div>

{% schema %}
{
  "name": "Erhvervsportal",
  "target": "section",
  "stylesheet": "erhverv.css",
  "javascript": "erhverv.js",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Erhvervskollektion", "info": "Kaffen, der vises under «Vælg varer». Kassestørrelser er varianter på produktet." },
    { "type": "url", "id": "apply_url", "label": "Side med ansøgningen" },
    { "type": "header", "content": "Ikke logget ind" },
    { "type": "text", "id": "guest_heading", "label": "Overskrift", "default": "Kaffe til erhverv" },
    { "type": "richtext", "id": "guest_text", "label": "Tekst", "default": "<p>Erhvervskunder bestiller her til egen pris og ser deres ordrer og fakturaer.</p>" },
    { "type": "header", "content": "Afventer og afvist" },
    { "type": "richtext", "id": "pending_text", "label": "Tekst, mens ansøgningen behandles", "default": "<p>Tak for ansøgningen. Vi kigger på den og skriver til jer, så snart aftalen er på plads — som regel inden for to hverdage.</p>" },
    { "type": "richtext", "id": "rejected_text", "label": "Tekst ved afvisning", "default": "<p>Vi kan desværre ikke tilbyde en erhvervsaftale lige nu. I er velkomne til at handle i webshoppen eller ringe til os.</p>" },
    { "type": "header", "content": "Jeres kontakt" },
    { "type": "text", "id": "contact_name", "label": "Navn", "default": "Café Costa Kalundborg" },
    { "type": "text", "id": "contact_phone", "label": "Telefon" },
    { "type": "text", "id": "contact_email", "label": "E-mail" }
  ]
}
{% endschema %}
